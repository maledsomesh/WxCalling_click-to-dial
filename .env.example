# ---------------------------------------------------------------------------
# Webex Click-to-Call token server configuration
# Copy to .env and fill in. NEVER commit .env - it holds Service App secrets.
# ---------------------------------------------------------------------------

# --- Service App credentials (Developer Portal > My Webex Apps > your Service App) ---
# Option A (quick test): paste the Service App access token generated after the
# Control Hub admin authorised the app. It expires (expiry shown in the portal) - fine for a PoC.
WEBEX_SERVICE_APP_ACCESS_TOKEN=

# Option B (production): the server refreshes the access token itself.
# Set all three; when set they take precedence over Option A.
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
WEBEX_REFRESH_TOKEN=

# --- Call destination ------------------------------------------------------
# Number of the Customer Assist Call Queue or Auto Attendant guests are connected to.
# Set server-side only - the browser can never choose where a guest call goes.
C2C_DESTINATION=

# Display name agents see for the guest (a visitor-supplied name is appended
# when C2C_ALLOW_GUEST_NAME=true, e.g. "Web Caller - Jane").
C2C_GUEST_NAME=Web Caller
C2C_ALLOW_GUEST_NAME=true

# --- Calling SDK (sent to the browser) --------------------------------------
# Pinned Webex JS SDK version loaded from unpkg in the browser.
WEBEX_SDK_VERSION=3.12.0
# Optional media region hint for the SDK, e.g. US-EAST / EU-WEST / AP-SOUTHEAST.
# Leave blank to let the SDK discover it.
WEBEX_REGION=
WEBEX_COUNTRY=

# --- Web server -------------------------------------------------------------
PORT=3000
# Comma-separated origins allowed to request call sessions (your website).
# Leave blank to allow same-origin only (the bundled demo page).
ALLOWED_ORIGINS=
# Max call sessions per client IP per window (abuse protection).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600
# Set when running behind a load balancer / reverse proxy so the real client IP
# (X-Forwarded-For) is used for rate limiting.
TRUST_PROXY=false

# Protects GET /api/diagnostics. Leave blank to disable the endpoint.
DIAGNOSTICS_KEY=
